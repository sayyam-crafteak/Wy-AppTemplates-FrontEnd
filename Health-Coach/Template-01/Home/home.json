              }
            },
            "div-s2d1d2d1d5": {
              "css": "bg-white bg-opacity-70 p-4 rounded-lg h-80 flex flex-col justify-center items-center transform transition-transform duration-300 hover:scale-105",
              "style": {
                "background-image": "url('div-s2d1d2d1d5.jpg')",
                "background-size": "cover"
